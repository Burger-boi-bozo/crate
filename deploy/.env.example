# The image produced by the GitHub Actions workflow. Use lowercase.
CRATE_IMAGE=ghcr.io/YOUR-GITHUB-USERNAME/YOUR-REPOSITORY:latest

# Copy only the eyJ... token from Cloudflare's tunnel install command.
CLOUDFLARE_TUNNEL_TOKEN=paste-your-tunnel-token-here

# Keep application authentication enabled, even behind the tunnel.
UDM_USERNAME=daniel
UDM_PASSWORD=replace-with-a-long-random-password
UDM_MAX_CONCURRENT=2

# Use an absolute path on your Proxmox host for a large drive.
DOWNLOAD_PATH=/mnt/media/Downloads
TZ=America/Chicago

